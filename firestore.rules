rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone with the link can READ everything (schedule, matches, players)
    // Only the signed-in admin can WRITE (mark winners, start live, seed data)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
